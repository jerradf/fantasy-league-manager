# Fantasy League Manager - Environment Variables
# Copy these to ~/.zshrc or ~/.bash_profile and fill in your values
# All logs and personal data stored in: ~/Library/Mobile Documents/com~apple~CloudDocs/FantasyLeague/

# Yahoo API Credentials
export YAHOO_CLIENT_ID="your_yahoo_client_id"
export YAHOO_CLIENT_SECRET="your_yahoo_client_secret"
export YAHOO_REFRESH_TOKEN="your_yahoo_refresh_token"

# Sleeper API
export SLEEPER_COOKIE="your_sleeper_cookie_for_write_operations"

# League 1 (Yahoo NBA Example)
export LEAGUE1_PLATFORM="yahoo_nba"
export LEAGUE1_ID="your_league_id"
export LEAGUE1_TEAM_NAME="Your Team Name"
export LEAGUE1_INACTIVE_ID=""  # Optional: inactive league to ignore
export LEAGUE1_ADDS_PER_WEEK="4"
export LEAGUE1_IL_SLOTS="3"
export LEAGUE1_SCORING="category"

# League 2 (Sleeper NFL Example with custom rules)
export LEAGUE2_PLATFORM="sleeper_nfl"
export LEAGUE2_ID="your_league_id"
export LEAGUE2_ROSTER_ID="your_roster_id"
export LEAGUE2_TEAM_NAME="Your Team Name"
export LEAGUE2_NO_TE_SLOT="true"
export LEAGUE2_TE_FLEX_ONLY="true"
export LEAGUE2_WAIVER_DAY="Tuesday"
export LEAGUE2_TRADE_DEADLINE="12"
export LEAGUE2_TRADE_REVIEW_DAYS="1"
export LEAGUE2_PLAYOFF_TEAMS="8"
export LEAGUE2_TOTAL_TEAMS="12"

# League 3 (Sleeper NFL Example with instant trades)
export LEAGUE3_PLATFORM="sleeper_nfl"
export LEAGUE3_ID="your_league_id"
export LEAGUE3_ROSTER_ID="your_roster_id"
export LEAGUE3_TEAM_NAME="Your Team Name"
export LEAGUE3_WAIVER_DAY="Tuesday"
export LEAGUE3_TRADE_DEADLINE="11"
export LEAGUE3_INSTANT_TRADES="true"
